# See https://docs.karakeep.app/configuration for more information

HOARDER_VERSION={{ karakeep_docker_version }}
KARAKEEP_VERSION={{ karakeep_docker_version }}

# Application logging verbosity level
LOG_LEVEL={{ karakeep_log_level }}

# Public address of service
NEXTAUTH_URL={{ karakeep_nextauth_url }}

# Random string used to sign the JWT tokens. Generate one with `openssl rand -base64 36`
NEXTAUTH_SECRET={{ karakeep_nextauth_secret }}
# Master key configured for meilisearch
MEILI_MASTER_KEY={{ karakeep_meili_master_key }}

# Sets the maximum allowed asset size (in MB) to be uploaded
MAX_ASSET_SIZE_MB={{ karakeep_max_asset_size_mb }}
# If set to true, latest release check will be disabled in the admin panel.
DISABLE_NEW_RELEASE_CHECK={{ karakeep_disable_new_release_check | ternary('true', 'false') }}
# If set to true, API rate limiting will be enabled.
RATE_LIMITING_ENABLED={{ karakeep_rate_limiting_enabled | ternary('true', 'false') }}
# Time window (ms) for per-domain crawler rate limiting
CRAWLER_DOMAIN_RATE_LIMIT_WINDOW_MS={{ karakeep_crawler_domain_rate_limit_window_ms }}
# Maximum crawler requests allowed per domain inside the configured window
CRAWLER_DOMAIN_RATE_LIMIT_MAX_REQUESTS={{ karakeep_crawler_domain_rate_limit_max_requests }}
# Enables WAL mode for the sqlite database. This should improve the performance of the database.
DB_WAL_MODE={{ karakeep_db_wal_mode | ternary('true', 'false') }}
# Number of concurrent workers for search indexing tasks
SEARCH_NUM_WORKERS={{ karakeep_search_num_workers }}
# How long to wait for a search indexing job to finish before timing out
SEARCH_JOB_TIMEOUT_SEC={{ karakeep_search_job_timeout_sec }}
# Number of concurrent workers for webhook delivery
WEBHOOK_NUM_WORKERS={{ karakeep_webhook_num_workers }}
# Number of concurrent workers for asset preprocessing tasks (image processing, OCR, etc.)
ASSET_PREPROCESSING_NUM_WORKERS={{ karakeep_asset_preprocessing_num_workers }}
# How long to wait for an asset preprocessing job to finish before timing out
ASSET_PREPROCESSING_JOB_TIMEOUT_SEC={{ karakeep_asset_preprocessing_job_timeout_sec }}
# Number of concurrent workers for rule engine processing
RULE_ENGINE_NUM_WORKERS={{ karakeep_rule_engine_num_workers }}
# The maximum number of RSS feeds a user can create
MAX_RSS_FEEDS_PER_USER={{ karakeep_max_rss_feeds_per_user }}
# The maximum number of webhooks a user can create
MAX_WEBHOOKS_PER_USER={{ karakeep_max_webhooks_per_user }}

# Authentication / Signup

# If enabled, no new signups will be allowed and the signup button will be disabled in the UI
DISABLE_SIGNUPS={{ karakeep_disable_signups | ternary('true', 'false') }}
# If enabled, only signups and logins using OAuth are allowed and the signup button and login form for local accounts will be disabled in the UI
DISABLE_PASSWORD_AUTH={{ karakeep_disable_password_auth | ternary('true', 'false') }}
# Whether email verification is required during signup. Requires SMTP to be configured.
EMAIL_VERIFICATION_REQUIRED={{ karakeep_email_verification_required | ternary('true', 'false') }}
# Auto-redirect to the OAuth provider on the login page
OAUTH_AUTO_REDIRECT={{ karakeep_oauth_auto_redirect | ternary('true', 'false') }}
# The "wellknown Url" for openid-configuration as provided by the OAuth provider
OAUTH_WELLKNOWN_URL={{ karakeep_oauth_wellknown_url }}
# The "Client Secret" as provided by the OAuth provider
OAUTH_CLIENT_SECRET={{ karakeep_oauth_client_secret }}
# The "Client ID" as provided by the OAuth provider
OAUTH_CLIENT_ID={{ karakeep_oauth_client_id }}
# Expected JWS signing algorithm for OIDC ID tokens, if your provider doesn't use the default
OAUTH_ID_TOKEN_SIGNED_RESPONSE_ALG={{ karakeep_oauth_id_token_signed_response_alg }}
# Full list of scopes to request (space delimited)"
OAUTH_SCOPE="{{ karakeep_oauth_scope }}"
# The name of your provider. Will be shown on the signup page as "Sign in with <name>"
OAUTH_PROVIDER_NAME="{{ karakeep_oauth_provider_name }}"
# Whether existing accounts in Karakeep stored in the database should automatically be linked with your OAuth account. Only enable it if you trust the OAuth provider!
OAUTH_ALLOW_DANGEROUS_EMAIL_ACCOUNT_LINKING={{ karakeep_oauth_allow_dangerous_email_account_linking | ternary('true', 'false') }}
# How long to wait for a response from the OAuth provider (ms)
OAUTH_TIMEOUT={{ karakeep_oauth_timeout }}

# Inference Configs (For automatic tagging)
OPENAI_API_KEY={{ karakeep_openai_api_key }}
OPENAI_BASE_URL={{ karakeep_openai_base_url }}
OPENAI_PROXY_URL={{ karakeep_openai_proxy_url }}
OPENAI_TIMEOUT_SEC={{ karakeep_openai_timeout_sec }}
OPENAI_SERVICE_TIER={{ karakeep_openai_service_tier }}
OPENAI_REASONING_EFFORT={{ karakeep_openai_reasoning_effort }}
OLLAMA_BASE_URL={{ karakeep_ollama_base_url }}
OLLAMA_KEEP_ALIVE={{ karakeep_ollama_keep_alive }}
SEMANTIC_SEARCH_ENABLED={{ karakeep_semantic_search_enabled | ternary('true', 'false') }}
INFERENCE_TEXT_MODEL={{ karakeep_inference_text_model }}
INFERENCE_IMAGE_MODEL={{ karakeep_inference_image_model }}
EMBEDDING_ENABLE_AUTO_INDEXING={{ karakeep_embedding_enable_auto_indexing | ternary('true', 'false') }}
EMBEDDING_OPENAI_API_KEY={{ karakeep_embedding_openai_api_key }}
EMBEDDING_OPENAI_BASE_URL={{ karakeep_embedding_openai_base_url }}
EMBEDDING_TEXT_MODEL={{ karakeep_embedding_text_model }}
EMBEDDING_TEXT_MODEL_DIMENSION_OVERRIDE={{ karakeep_embedding_text_model_dimension_override }}
EMBEDDING_CONTEXT_LENGTH={{ karakeep_embedding_context_length }}
EMBEDDING_DIMENSIONS={{ karakeep_embedding_dimensions }}
EMBEDDING_NUM_WORKERS={{ karakeep_embedding_num_workers }}
EMBEDDING_JOB_TIMEOUT_SEC={{ karakeep_embedding_job_timeout_sec }}
INFERENCE_CONTEXT_LENGTH={{ karakeep_inference_context_length }}
INFERENCE_MAX_OUTPUT_TOKENS={{ karakeep_inference_max_output_tokens }}
INFERENCE_USE_MAX_COMPLETION_TOKENS={{ karakeep_inference_use_max_completion_tokens | ternary('true', 'false') }}
INFERENCE_LANG={{ karakeep_inference_lang }}
INFERENCE_NUM_WORKERS={{ karakeep_inference_num_workers }}
INFERENCE_ENABLE_AUTO_TAGGING={{ karakeep_inference_enable_auto_tagging | ternary('true', 'false') }}
INFERENCE_ENABLE_AUTO_SUMMARIZATION={{ karakeep_inference_enable_auto_summarization | ternary('true', 'false') }}
INFERENCE_JOB_TIMEOUT_SEC={{ karakeep_inference_job_timeout_sec }}
INFERENCE_FETCH_TIMEOUT_SEC={{ karakeep_inference_fetch_timeout_sec }}
INFERENCE_OUTPUT_SCHEMA={{ karakeep_inference_output_schema }}

# Crawler Configs
CRAWLER_NUM_WORKERS={{ karakeep_crawler_num_workers }}
BROWSER_WEB_URL={{ karakeep_browser_web_url }}
BROWSER_WEBSOCKET_URL={{ karakeep_browser_websocket_url }}
BROWSER_CONNECT_ONDEMAND={{ karakeep_browser_connect_ondemand | ternary('true', 'false') }}
CRAWLER_DOWNLOAD_BANNER_IMAGE={{ karakeep_crawler_download_banner_image | ternary('true', 'false') }}
CRAWLER_STORE_SCREENSHOT={{ karakeep_crawler_store_screenshot | ternary('true', 'false') }}
CRAWLER_FULL_PAGE_SCREENSHOT={{ karakeep_crawler_full_page_screenshot | ternary('true', 'false') }}
CRAWLER_SCREENSHOT_TIMEOUT_SEC={{ karakeep_crawler_screenshot_timeout_sec }}
CRAWLER_STORE_PDF={{ karakeep_crawler_store_pdf | ternary('true', 'false') }}
CRAWLER_FULL_PAGE_ARCHIVE={{ karakeep_crawler_full_page_archive | ternary('true', 'false') }}
CRAWLER_JOB_TIMEOUT_SEC={{ karakeep_crawler_job_timeout_sec }}
CRAWLER_NAVIGATE_TIMEOUT_SEC={{ karakeep_crawler_navigate_timeout_sec }}
CRAWLER_PREFLIGHT_USER_AGENT={{ karakeep_crawler_preflight_user_agent }}
CRAWLER_PARSE_TIMEOUT_SEC={{ karakeep_crawler_parse_timeout_sec }}
CRAWLER_PARSER_MEM_LIMIT_MB={{ karakeep_crawler_parser_mem_limit_mb }}
CRAWLER_VIDEO_DOWNLOAD={{ karakeep_crawler_video_download | ternary('true', 'false') }}
CRAWLER_VIDEO_DOWNLOAD_MAX_SIZE={{ karakeep_crawler_video_download_max_size }}
CRAWLER_VIDEO_DOWNLOAD_TIMEOUT_SEC={{ karakeep_crawler_video_download_timeout_sec }}
CRAWLER_ENABLE_ADBLOCKER={{ karakeep_crawler_enable_adblocker | ternary('true', 'false') }}
CRAWLER_ENABLE_AUTOCONSENT={{ karakeep_crawler_enable_autoconsent | ternary('true', 'false') }}
CRAWLER_YTDLP_ARGS={{ karakeep_crawler_ytdlp_args }}
CRAWLER_MONOLITH_TIMEOUT_SEC={{ karakeep_crawler_monolith_timeout_sec }}
CRAWLER_MONOLITH_ARGS={{ karakeep_crawler_monolith_args }}
HTML_CONTENT_SIZE_INLINE_THRESHOLD_BYTES={{ karakeep_html_content_size_inline_threshold_bytes }}

# OCR Configs
OCR_CACHE_DIR={{ karakeep_ocr_cache_dir }}
OCR_LANGS={{ karakeep_ocr_langs }}
OCR_CONFIDENCE_THRESHOLD={{ karakeep_ocr_confidence_threshold }}
OCR_USE_LLM={{ karakeep_ocr_use_llm | ternary('true', 'false') }}

# SMTP Configuration
SMTP_HOST={{ karakeep_smtp_host }}
SMTP_PORT={{ karakeep_smtp_port }}
SMTP_SECURE={{ karakeep_smtp_secure | ternary('true', 'false') }}
SMTP_USER={{ karakeep_smtp_user }}
SMTP_PASSWORD={{ karakeep_smtp_password }}
SMTP_FROM={{ karakeep_smtp_from }}

# Proxy Configuration
CRAWLER_HTTP_PROXY={{ karakeep_crawler_http_proxy }}
CRAWLER_HTTPS_PROXY={{ karakeep_crawler_https_proxy }}
CRAWLER_NO_PROXY={{ karakeep_crawler_no_proxy }}
CRAWLER_ALLOWED_INTERNAL_HOSTNAMES={{ karakeep_crawler_allowed_internal_hostnames }}
